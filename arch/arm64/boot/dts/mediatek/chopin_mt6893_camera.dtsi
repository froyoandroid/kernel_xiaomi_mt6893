		};
	};

	camera_pins_cam4_mclk_6ma: cam4_mclk_6ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO151__FUNC_CMMCLK2>;
			drive-strength = <3>;
		};
	};

	camera_pins_cam4_mclk_8ma: cam4_mclk_8ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO151__FUNC_CMMCLK2>;
			drive-strength = <3>;
		};
	};

	camera_pins_default: camdefault {
	};
};

/* MAIN CAMERA HARDWARE CONFIGURATION - Stock Chopin Fragment@26 */
&kd_camera_hw1 {
	cam0_vcamio-supply = <&mt_pmic_vcamio_ldo_reg>;
	cam1_vcamio-supply = <&mt_pmic_vcamio_ldo_reg>;
	cam2_vcamio-supply = <&mt_pmic_vcamio_ldo_reg>;
	cam3_vcamio-supply = <&mt_pmic_vcamio_ldo_reg>;

	/* Power Supplies - Mix of wl2866d1 and wl2866d2 regulators */
	cam0_vcamd-supply = <&wl2866d1_dvdd2>;
	cam0_vcama-supply = <&wl2866d1_avdd1>;
	cam1_vcamd-supply = <&wl2866d1_dvdd1>;
	cam1_vcama-supply = <&wl2866d1_avdd2>;
	cam2_vcama-supply = <&wl2866d2_avdd1>;
	cam3_vcamd-supply = <&wl2866d2_dvdd1>;
	cam3_vcama-supply = <&wl2866d2_avdd1>;

	/* Sensor Configurations - Stock Chopin sensors */
	cam0_enable_sensor = "ov64b40sunny_mipi_raw";
	cam1_enable_sensor = "ov16a1qofilm_mipi_raw";
	cam2_enable_sensor = "gc02m1sunny_mipi_raw";
	cam3_enable_sensor = "imx355sunny_mipi_raw";

	pinctrl-names = "default",
			"cam0_rst0", "cam0_rst1",
			"cam0_pnd0", "cam0_pnd1",
			"cam1_rst0", "cam1_rst1",
			"cam1_pnd0", "cam1_pnd1",
			"cam2_rst0", "cam2_rst1",
			"cam2_pnd0", "cam2_pnd1",
			"cam3_rst0", "cam3_rst1",
			"cam3_pnd0", "cam3_pnd1",
			"cam4_rst0", "cam4_rst1",
			"cam4_pnd0", "cam4_pnd1",
			"cam0_mclk_off",
			"cam0_mclk_2mA", "cam0_mclk_4mA",
			"cam0_mclk_6mA", "cam0_mclk_8mA",
			"cam1_mclk_off",
			"cam1_mclk_2mA", "cam1_mclk_4mA",
			"cam1_mclk_6mA", "cam1_mclk_8mA",
			"cam2_mclk_off",
			"cam2_mclk_2mA", "cam2_mclk_4mA",
			"cam2_mclk_6mA", "cam2_mclk_8mA",
			"cam3_mclk_off",
			"cam3_mclk_2mA", "cam3_mclk_4mA",
			"cam3_mclk_6mA", "cam3_mclk_8mA",
			"cam4_mclk_off",
			"cam4_mclk_2mA", "cam4_mclk_4mA",
			"cam4_mclk_6mA", "cam4_mclk_8mA";

	pinctrl-0 = <&camera_pins_default>;
	pinctrl-1 = <&camera_pins_cam0_rst_0>;
	pinctrl-2 = <&camera_pins_cam0_rst_1>;
	pinctrl-3 = <&camera_pins_cam0_pnd_0>;
	pinctrl-4 = <&camera_pins_cam0_pnd_1>;
	pinctrl-5 = <&camera_pins_cam1_rst_0>;
	pinctrl-6 = <&camera_pins_cam1_rst_1>;
	pinctrl-7 = <&camera_pins_cam1_pnd_0>;
	pinctrl-8 = <&camera_pins_cam1_pnd_1>;
	pinctrl-9 = <&camera_pins_cam2_rst_0>;
	pinctrl-10 = <&camera_pins_cam2_rst_1>;
	pinctrl-11 = <&camera_pins_cam2_pnd_0>;
	pinctrl-12 = <&camera_pins_cam2_pnd_1>;
	pinctrl-13 = <&camera_pins_cam3_rst_0>;
	pinctrl-14 = <&camera_pins_cam3_rst_1>;
	pinctrl-15 = <&camera_pins_cam3_pnd_0>;
	pinctrl-16 = <&camera_pins_cam3_pnd_1>;
	pinctrl-17 = <&camera_pins_cam4_rst_0>;
	pinctrl-18 = <&camera_pins_cam4_rst_1>;
	pinctrl-19 = <&camera_pins_cam4_pnd_0>;
	pinctrl-20 = <&camera_pins_cam4_pnd_1>;
	pinctrl-21 = <&camera_pins_cam0_vcamd_0>;
	pinctrl-22 = <&camera_pins_cam0_vcamd_1>;
	pinctrl-23 = <&camera_pins_cam0_vcama_0>;
	pinctrl-24 = <&camera_pins_cam0_vcama_1>;
	pinctrl-25 = <&camera_pins_cam1_vcamd_0>;
	pinctrl-26 = <&camera_pins_cam1_vcamd_1>;
	pinctrl-27 = <&camera_pins_cam1_vcama_0>;
	pinctrl-28 = <&camera_pins_cam1_vcama_1>;
	pinctrl-29 = <&camera_pins_cam2_vcamd_0>;
	pinctrl-30 = <&camera_pins_cam2_vcamd_1>;
	pinctrl-31 = <&camera_pins_cam2_vcama_0>;
	pinctrl-32 = <&camera_pins_cam2_vcama_1>;
	pinctrl-33 = <&camera_pins_cam3_vcamd_0>;
	pinctrl-34 = <&camera_pins_cam3_vcamd_1>;
	pinctrl-35 = <&camera_pins_cam3_vcama_0>;
	pinctrl-36 = <&camera_pins_cam3_vcama_1>;
	pinctrl-37 = <&camera_pins_cam4_vcamd_0>;
	pinctrl-38 = <&camera_pins_cam4_vcamd_1>;
	pinctrl-39 = <&camera_pins_cam4_vcama_0>;
	pinctrl-40 = <&camera_pins_cam4_vcama_1>;
	pinctrl-41 = <&camera_pins_cam0_mclk_off>;
	pinctrl-42 = <&camera_pins_cam0_mclk_2ma>;
	pinctrl-43 = <&camera_pins_cam0_mclk_4ma>;
	pinctrl-44 = <&camera_pins_cam0_mclk_6ma>;
	pinctrl-45 = <&camera_pins_cam0_mclk_8ma>;
	pinctrl-46 = <&camera_pins_cam1_mclk_off>;
	pinctrl-47 = <&camera_pins_cam1_mclk_2ma>;
	pinctrl-48 = <&camera_pins_cam1_mclk_4ma>;
	pinctrl-49 = <&camera_pins_cam1_mclk_6ma>;
	pinctrl-50 = <&camera_pins_cam1_mclk_8ma>;
	pinctrl-51 = <&camera_pins_cam2_mclk_off>;
	pinctrl-52 = <&camera_pins_cam2_mclk_2ma>;
	pinctrl-53 = <&camera_pins_cam2_mclk_4ma>;
	pinctrl-54 = <&camera_pins_cam2_mclk_6ma>;
	pinctrl-55 = <&camera_pins_cam2_mclk_8ma>;
	pinctrl-56 = <&camera_pins_cam3_mclk_off>;
	pinctrl-57 = <&camera_pins_cam3_mclk_2ma>;
	pinctrl-58 = <&camera_pins_cam3_mclk_4ma>;
	pinctrl-59 = <&camera_pins_cam3_mclk_6ma>;
	pinctrl-60 = <&camera_pins_cam3_mclk_8ma>;
	pinctrl-61 = <&camera_pins_cam4_mclk_off>;
	pinctrl-62 = <&camera_pins_cam4_mclk_2ma>;
	pinctrl-63 = <&camera_pins_cam4_mclk_4ma>;
	pinctrl-64 = <&camera_pins_cam4_mclk_6ma>;
	pinctrl-65 = <&camera_pins_cam4_mclk_8ma>;

	status = "okay";
};

&i2c2 {
	mtk_camera_eeprom0: camera_eeprom0@51 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x51>;
		status = "okay";
	};
};

&i2c4 {
	mtk_camera_eeprom1: camera_eeprom1@51 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x51>;
		status = "okay";
	};

	mtk_camera_eeprom4: camera_eeprom4@51 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x51>;
		status = "okay";
	};
};

